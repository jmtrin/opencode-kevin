// v1.0.0 (K10-002 / plan §3.1e) — editor and `typecheck` config spanning tests/scripts/plugin deliberately; narrowing `include` would relocate the published entry point.
{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"outDir": "dist",
		"types": ["node"],
		"resolveJsonModule": true,
		"declaration": true,
		"sourceMap": true
	},
	"include": ["plugin/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
