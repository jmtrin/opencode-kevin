{
	"name": "opencode-kevin-monorepo",
	"private": true,
	"version": "2.1.0",
	"description": "Kevin monorepo — workspaces manager (Bedrock)",
	"type": "module",
	"workspaces": ["packages/*"],
	"scripts": {
		"build": "npm run build -w @jmtrin/kevin-core && npm run build -w @jmtrin/opencode-kevin-tui && npm run build -w @jmtrin/opencode-kevin",
		"prepublishOnly": "echo \"use per-package publish\"",
		"test": "vitest run",
		"test:unit": "vitest run tests/unit",
		"test:integration": "vitest run tests/integration",
		"test:e2e": "vitest run tests/e2e",
		"typecheck": "npm run typecheck -w @jmtrin/kevin-core && npm run typecheck -w @jmtrin/opencode-kevin-tui && npm run typecheck -w @jmtrin/opencode-kevin && tsc --noEmit --project tsconfig.json",
		"lint": "biome check .",
		"format": "biome format --write .",
		"verify": "node --import tsx scripts/verify-install.ts && npm run verify:pack",
		"verify:pack": "node --import tsx scripts/verify-pack.ts",
		"bench": "node --import tsx scripts/bench.ts",
		"gen:corpus": "node --import tsx scripts/gen-corpus.ts",
		"bench:check": "node --import tsx scripts/bench-check.ts",
		"bench:regress": "tsx scripts/bench-regress.ts",
		"replay": "node --import tsx scripts/replay.ts",
		"measure:mix": "node --import tsx scripts/measure-mix.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@modelcontextprotocol/sdk": "^1.30.0",
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.10.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.2",
		"vitest": "^2.1.8",
		"zod": "^4.5.2"
	},
	"dependencies": {
		"@opencode-ai/plugin": "^1.18.16"
	},
	"optionalDependencies": {
		"better-sqlite3": "^12.11.0"
	},
	"engines": {
		"node": ">=22.5.0",
		"opencode": "^1.18.0"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/jmtrin/opencode-kevin.git"
	},
	"homepage": "https://github.com/jmtrin/opencode-kevin#readme",
	"bugs": {
		"url": "https://github.com/jmtrin/opencode-kevin/issues"
	},
	"keywords": ["opencode", "plugin", "memory", "learning", "ai"],
	"author": "jmtrin",
	"publishConfig": {
		"access": "public"
	},
	"license": "MIT"
}
